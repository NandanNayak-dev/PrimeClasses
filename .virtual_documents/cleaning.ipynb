# Strings
df=pd.read_csv("raw_data.csv")
df["gender"].str.upper()

df["name"].str.split()
df["country"].str.contains("US")

df["country"].str.contains("india",case=False)


df


# Feature Engineering
df2=df.copy()
df2["tax"]=df["income"].apply(lambda x:"20%" if x>=50000 else "10%")
df2


# map()
df2=df.copy()
gender_map={"Male":"M","Female":"F","Unknown":"U"}
df2["gender"]=df2["gender"].map(gender_map)
df2


# assign()
df2.assign(new_income=df2["income"]*1.1)



# replace()
df2["country"]=df2["country"].replace("USA","United States")



